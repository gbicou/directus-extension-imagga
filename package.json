{
  "name": "@bicou/directus-extension-imagga",
  "description": "Automatic image tagging of Directus files with Imagga API",
  "homepage": "https://github.com/gbicou/directus-extension-imagga",
  "author": "Benjamin VIELLARD <bicou@bicou.com>",
  "license": "MIT",
  "repository": "github:gbicou/directus-extension-imagga",
  "icon": "extension",
  "version": "1.6.6",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook",
    "image",
    "tag",
    "auto-tagging",
    "imagga"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.mjs",
    "source": "src/index.ts",
    "host": "^11.1.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@directus/api": "^35.0.0",
    "@directus/extensions-sdk": "^17.0.0",
    "axios": "^1.9.0",
    "form-data": "^4.0.2"
  },
  "devDependencies": {
    "@directus/sdk": "21.2.2",
    "@directus/tsconfig": "4.0.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.19.17",
    "dotenv": "17.4.2",
    "eslint": "10.4.1",
    "eslint-plugin-unicorn": "64.0.0",
    "rollup-plugin-node-externals": "8.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.9",
    "wiremock-captain": "4.1.3"
  },
  "peerDependencies": {
    "@directus/api": "^33.0.0 || ^35.0.0",
    "@directus/env": "^5.0.2",
    "@directus/extensions-sdk": "^17.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
